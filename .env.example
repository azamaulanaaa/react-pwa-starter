# Generic API client (src/lib/api).
# The default is /api on the same origin. Set an absolute URL for another host.
VITE_API_BASE_URL=/api

# Optional rust-api adapter (src/integrations/rust-api).
# The adapter is off by default. Set this value to true to mount it.
VITE_RUST_API_ENABLED=false
# `/` means the SPA origin. The Vite dev server proxies /auth, /fs and /sync to
# http://localhost:8080, so the login callback returns to the SPA.
# Use an absolute URL only for a direct cross-origin setup.
VITE_RUST_API_BASE_URL=/
# VITE_RUST_API_BASE_URL=http://localhost:8080

# OpenTelemetry (all optional — defaults shown)
#
# Base URL of an OTLP/HTTP collector (Jaeger, Grafana Tempo/Alloy,
# Aspire Dashboard, Honeycomb, Datadog OTLP intake, ...).
# Traces, metrics and logs are exported to <endpoint>/v1/{traces,metrics,logs}.
# The rust-api backend needs the full signal path, for example
# http://localhost:4318/v1/traces. See readme.md for the alignment.
VITE_OTEL_ENDPOINT=http://localhost:4318

# Override service.name resource attribute (defaults to package.json name).
# VITE_OTEL_SERVICE_NAME=my-service

# Root span sampling ratio in [0, 1] (default: 1 = sample everything).
# VITE_OTEL_SAMPLE_RATIO=1

# Metric export interval in ms (default: 30000).
# VITE_OTEL_METRIC_EXPORT_INTERVAL_MS=30000

# Master kill-switch — set to false to disable all telemetry.
# VITE_OTEL_ENABLED=true

# Require explicit consent before telemetry starts (GDPR-style opt-in).
# When true, call setTelemetryConsent(true) from src/telemetry/api.ts once
# the user opts in; until then nothing is collected or exported.
# VITE_OTEL_REQUIRE_CONSENT=false
